#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <input/processors.dtsi>

#define BASE         0
#define MOUSE        1
#define SCRL         2
#define LOWER        3
#define RAISE        4
#define FUNC         5
#define GAME         6
#define G_N          7
#define ADJUST       8

#define LEFT_HAND  0  1  2  3  4  5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 50 51 52 53 54
#define RIGHT_HAND 6  7  8  9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 44 45 46 47 48 49 55 56 57 58 59

// Mouse layers

&mmv {
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

&msc {
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

/ {
    trackball_listener {
        compatible = "zmk,input-listener";
        device = <&trackball>;

        scroll_view {
            layers = <SCRL>;
            input-processors = <&zip_xy_scaler 1 16>,
                               <&zip_xy_transform INPUT_TRANSFORM_X_INVERT>,
                               <&zip_xy_to_scroll_mapper>;
        };

        snipe_view {
            layers = <RAISE>;
            input-processors = <&zip_xy_scaler 1 3>;
        };
    };
};

/ {
    combos {
        compatible = "zmk,combos";
        require-prior-idle-ms = <100>;

        combo_CAPSWORD {
            timeout-ms = <50>;
            key-positions = <28 31>;
            bindings = <&caps_word>;
        };

        // Mouse Buttons
        combo_mkback {
            timeout-ms = <50>;
            key-positions = <18 30>;
            bindings = <&mkp MB4>;
        };
        combo_mkleft {
            timeout-ms = <50>;
            key-positions = <19 31>;
            bindings = <&mkp LCLK>;
        };
        combo_scrllayer {
            timeout-ms = <50>;
            key-positions = <20 32>;
            bindings = <&l_mkp SCRL MCLK>;
        };
        combo_mkright {
            timeout-ms = <50>;
            key-positions = <21 33>;
            bindings = <&mkp RCLK>;
        };
        combo_mkfrw {
            timeout-ms = <50>;
            key-positions = <22 34>;
            bindings = <&mkp MB5>;
        };
        combo_mkmiddle {
            timeout-ms = <50>;
            key-positions = <32 46>;
            bindings = <&mkp MCLK>;
        };
    };

    behaviors {
        td_media: tap_dance_media {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp C_PLAY>, <&kp C_NEXT>, <&kp C_PREV>;
        };

        hm_l: homerow_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
            hold-trigger-key-positions = < RIGHT_HAND >;
            hold-trigger-on-release;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };

        hm_r: homerow_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
            hold-trigger-key-positions = < LEFT_HAND >;
            hold-trigger-on-release;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };

        ihm_l: hrm_index_l {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <150>;
            hold-trigger-key-positions = < RIGHT_HAND >;
            hold-trigger-on-release;
            require-prior-idle-ms = <50>;
            quick-tap-ms = <150>;
            bindings = <&kp>, <&kp>;
        };

        ihm_r: hrm_index_r {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <150>;
            hold-trigger-key-positions = < LEFT_HAND >;
            hold-trigger-on-release;
            require-prior-idle-ms = <50>;
            quick-tap-ms = <150>;
            bindings = <&kp>, <&kp>;
        };

        slt: smart_thumb_layer_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&mo>, <&kp>;
        };

        l_mkp: layer_tap_mkp {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <100>;
            bindings = <&mo>, <&mkp>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        adjust_layer {
            if-layers = <LOWER RAISE>;
            then-layer = <ADJUST>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        BASE {
            display-name = "toddy";
            bindings = <
            &none           &none           &none           &none           &none           &none                                           &none           &none           &none           &none           &none           &none
            &none           &kp Q           &kp W           &kp E           &kp R           &kp T                                           &kp Y           &kp U           &kp I           &kp O           &kp P           &none
            &none           &hm_l LCMD A    &hm_l LALT S    &hm_l LCTRL D   &ihm_l LSHFT F  &kp G                                           &kp H           &ihm_r RSHFT J  &hm_r RCTRL K   &hm_r LALT L    &hm_r RCMD SEMI &none
            &none           &kp Z           &kp X           &kp C           &kp V           &kp B           &td_media       &none           &kp N           &kp M           &kp COMMA       &kp DOT         &kp FSLH        &none
                                            &none           &none           &kp ESC         &slt RAISE BSPC &kp RET         &slt FUNC TAB   &slt LOWER SPACE &kp DEL        &none           &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        MOUSE {
            display-name = "mouse";
            bindings = <
            &none           &none           &none           &none           &none           &none                                           &none           &none           &none           &none           &none           &none
            &none           &trans          &trans          &trans          &trans          &trans                                          &none           &none           &mkp MB3        &none           &none           &none
            &none           &trans          &trans          &trans          &trans          &trans                                          &mkp MB4        &mkp MB1        &l_mkp SCRL MB3 &mkp MB2        &mkp MB5        &none
            &none           &trans          &trans          &trans          &trans          &trans          &trans          &none           &none           &none           &none           &none           &none           &none
                                            &none           &none           &tog MOUSE      &trans          &trans          &trans          &trans          &trans          &none           &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP>;
        };

        SCRL {
            display-name = "scroll";
            bindings = <
            &none           &none            &none            &none             &none              &none                                    &none           &none           &none           &none           &none           &none
            &none           &kp LC(Q)        &kp LC(W)        &kp LC(E)         &kp LC(R)          &kp LC(T)                                &trans          &trans          &trans          &trans          &trans          &none
            &none           &hm_l LGUI LC(A) &hm_l LALT LC(S) &hm_l LCTRL LC(D) &ihm_l LSHFT LC(F) &kp LC(G)                                &trans          &trans          &trans          &trans          &trans          &none
            &none           &kp LC(Z)        &kp LC(X)        &kp LC(C)         &kp LC(V)          &kp LC(B) &trans         &none           &trans          &trans          &trans          &trans          &trans          &none
                                             &none            &none             &trans             &trans    &trans         &trans          &trans          &trans          &none           &none
            >;
        };

        LOWER {
            display-name = "num-nav";
            bindings = <
            &none           &none           &none           &none           &none           &none                                           &none           &none           &none           &none           &none           &none
            &none           &kp LS(LBKT)    &kp N7          &kp N8          &kp N9          &kp LS(RBKT)                                    &trans          &to MOUSE       &kp HOME        &kp END         &kp PAGE_UP     &none
            &none           &hm_l LCMD LBKT &hm_l LALT N4   &hm_l LCTRL N5  &ihm_l LSHFT N6 &kp RBKT                                        &kp LEFT        &kp DOWN        &kp UP          &kp RIGHT       &kp PAGE_DOWN   &none
            &none           &kp N0          &kp N1          &kp N2          &kp N3          &kp DOT         &trans          &kp LG(0)       &trans          &to BASE        &trans          &trans          &trans          &none
                                            &none           &none           &trans          &trans          &trans          &trans          &trans          &trans          &none           &none
            >;

            sensor-bindings = <&inc_dec_kp LG(MINUS) LG(PLUS)>;
        };

        RAISE {
            display-name = "symbol";
            bindings = <
            &none           &none           &none           &none           &none           &none                                           &none           &none           &none           &none           &none           &none
            &none           &kp LS(N1)      &kp LS(N2)      &kp LS(N3)      &kp LS(N4)      &kp LS(N5)                                      &kp LS(N6)      &kp LS(N7)      &kp LS(N8)      &kp DQT         &kp SQT         &none
            &none           &kp LS(LBKT)    &kp LBKT        &kp LS(N9)      &kp MINUS       &kp LS(MINUS)                                   &kp LS(EQUAL)   &kp EQUAL       &kp LS(N0)      &kp RBKT        &kp LS(RBKT)    &none
            &none           &trans          &trans          &kp LS(GRAVE)   &kp GRAVE       &trans          &trans          &trans          &kp LS(BSLH)    &trans          &trans          &trans          &kp BSLH        &none
                                            &none           &none           &trans          &trans          &trans          &trans          &trans          &trans          &none           &none
            >;

            sensor-bindings = <&inc_dec_kp LG(PLUS) LG(MINUS)>;
        };

        FUNC {
            display-name = "func";
            bindings = <
            &none           &none           &none           &none           &none           &none                                           &none           &none           &none           &none           &none           &none
            &none           &kp F12         &kp F7          &kp F8          &kp F9          &trans                                          &trans          &kp C_VOL_UP    &kp C_BRI_INC   &trans          &trans          &none
            &none           &kp F11         &kp F4          &kp F5          &kp F6          &kp RALT                                        &trans          &kp C_VOL_DN    &kp C_BRI_DEC   &trans          &trans          &none
            &none           &kp F10         &kp F1          &kp F2          &kp F3          &kp PAUSE_BREAK &trans          &trans          &trans          &kp C_PREV      &kp C_PLAY      &kp C_NEXT      &trans          &none
                                            &none           &none           &trans          &trans          &trans          &trans          &trans          &trans          &none           &none
            >;
        };

        GAME {
            display-name = "game";
            bindings = <
            &none           &none           &none           &none           &none           &none                                           &none           &none           &none           &none           &none           &none
            &none           &kp TAB         &kp Q           &kp W           &kp E           &kp R                                           &trans          &trans          &trans          &trans          &trans          &none
            &none           &kp LSHFT       &kp A           &kp S           &kp D           &kp F                                           &trans          &trans          &trans          &trans          &trans          &none
            &none           &kp LCTRL       &kp Z           &kp X           &kp C           &kp V           &trans          &trans          &trans          &trans          &trans          &trans          &trans          &none
                                            &none           &none           &kp ESC         &lt G_N SPACE   &kp LALT        &trans          &trans          &trans          &none           &none
            >;
        };

        G_N {
            display-name = "game numbers";
            bindings = <
            &none           &none           &none           &none           &none           &none                                           &none           &none           &none           &none           &none           &none
            &none           &trans          &kp N1          &kp N2          &kp N3          &kp N4                                          &tog GAME       &trans          &trans          &trans          &trans          &none
            &none           &trans          &kp N5          &kp N6          &kp N7          &kp N8                                          &trans          &trans          &trans          &trans          &trans          &none
            &none           &trans          &kp LC(N1)      &kp LC(N2)      &kp LC(N3)      &kp LC(N4)      &trans          &trans          &trans          &trans          &trans          &trans          &trans          &none
                                            &none           &none           &trans          &trans          &trans          &trans          &trans          &trans          &none           &none
            >;
        };

        ADJUST {
            display-name = "adjust";
            bindings = <
            &none           &none           &none           &none           &none           &none                                           &none           &none           &none           &none           &none           &none
            &none           &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3    &bt BT_SEL 4                                    &tog GAME       &none           &none           &none           &bt BT_CLR      &none
            &none           &none           &mmv MOVE_LEFT  &mmv MOVE_UP    &mmv MOVE_RIGHT &msc SCRL_UP                                    &none           &none           &none           &none           &out OUT_TOG    &none
            &none           &none           &mkp MB2        &mmv MOVE_DOWN  &mkp MB1        &msc SCRL_DOWN  &none           &none           &none           &none           &none           &none           &none           &none
                                            &none           &none           &none           &none           &none           &none           &none           &none           &none           &none
            >;

            sensor-bindings = <&inc_dec_kp C_BRI_DEC C_BRI_INC>;
        };
    };
};
